  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#8A7856",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Documentation comment",
      "scope": [
        "comment.block.documentation",
        "comment.documentation"
      ],
      "settings": {
        "foreground": "#9C8B6A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables and plain identifiers",
      "scope": [
        "variable",
        "string constant.other.placeholder",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#E2D2AC"
      }
    },
    {
      "name": "Language variables",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#DC5565",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#D5C199",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties and fields",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#CFC978"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.other",
        "storage",
        "storage.type",
        "storage.modifier",
        "variable.other.dollar.only.sql"
      ],
      "settings": {
        "foreground": "#DC5565"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.accessor",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#D89B3F"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#A8966F"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "meta.function-call.generic",
        "support.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#F0C05A"
      }
    },
    {
      "name": "Macros and decorators",
      "scope": [
        "entity.name.function.macro",
        "meta.decorator",
        "meta.annotation",
        "punctuation.definition.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#B58099",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Types, classes and structs",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.trait",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "storage.type.class",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#E8A96A"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#E8A96A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#9FB45F"
      }
    },
    {
      "name": "String interpolation and escapes",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "meta.embedded.line"
      ],
      "settings": {
        "foreground": "#B58099"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "keyword.operator.quantifier.regexp"
      ],
      "settings": {
        "foreground": "#CE99B1"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D2803F"
      }
    },
    {
      "name": "Booleans and null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nil"
      ],
      "settings": {
        "foreground": "#DC5565"
      }
    },
    {
      "name": "Constants in caps",
      "scope": [
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#E0B45E"
      }
    },
    {
      "name": "Atoms, symbols and enum members",
      "scope": [
        "constant.other.symbol",
        "constant.language.symbol",
        "variable.other.enummember",
        "constant.other.keyword"
      ],
      "settings": {
        "foreground": "#CFC978"
      }
    },
    {
      "name": "Markup and tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#DC5565"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name",
        "meta.tag.attributes"
      ],
      "settings": {
        "foreground": "#E0B45E",
