        "foreground": "#FFD47A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.name.tag.css"
      ],
      "settings": {
        "foreground": "#FFB93D"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss"
      ],
      "settings": {
        "foreground": "#F2DB6A"
      }
    },
    {
      "name": "Modules and imports",
      "scope": [
        "entity.name.module",
        "support.module",
        "meta.import",
        "meta.export",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#FF4D5E"
      }
    },
    {
      "name": "Labels",
      "scope": [
        "entity.name.label",
        "meta.label"
      ],
      "settings": {
        "foreground": "#D977B4"
      }
