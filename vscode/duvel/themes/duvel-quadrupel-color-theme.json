    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFF3DE",
        "background": "#A31E2C"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FF8A3C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#FF6B52",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#F79C62",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#F79C62",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link",
        "markup.link"
      ],
      "settings": {
        "foreground": "#EE9BCC",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#BCDC5F"
      }
    },
    {
      "name": "Markdown quotes and lists",
      "scope": [
        "markup.quote",
        "beginning.punctuation.definition.list.markdown",
        "beginning.punctuation.definition.quote.markdown"
      ],
      "settings": {
        "foreground": "#B79A7C"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#BCDC5F"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF4D5E"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#FFB93D"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json",
        "string.json support.type.property-name"
      ],
      "settings": {
        "foreground": "#F2DB6A"
      }
    },
    {
      "name": "Shell built-ins",
      "scope": [
        "support.function.builtin.shell",
        "entity.name.command.shell"
      ],
      "settings": {
        "foreground": "#FFB93D"
      }
    }
  ],
  "semanticTokenColors": {
    "variable.defaultLibrary": "#F79C62",
    "property": "#F2DB6A",
    "property.declaration": "#F2DB6A",
    "parameter": {
      "foreground": "#E4C9A4",
      "fontStyle": "italic"
    },
    "function": {
      "foreground": "#FFB93D",
      "fontStyle": "bold"
    },
    "method": {
      "foreground": "#FFB93D",
      "fontStyle": "bold"
    },
    "macro": {
      "foreground": "#D977B4",
      "fontStyle": "italic"
    },
    "class": "#F79C62",
    "struct": "#F79C62",
    "interface": "#F79C62",
    "enum": "#F79C62",
    "enumMember": "#CE8ADC",
    "typeParameter": {
      "foreground": "#F79C62",
      "fontStyle": "italic"
    },
    "namespace": "#FF4D5E",
    "type": "#F79C62",
    "selfKeyword": {
      "foreground": "#FF4D5E",
      "fontStyle": "bold italic"
    },
    "*.readonly": "#FFD47A",
    "*.deprecated": {
      "fontStyle": "strikethrough"
    },
    "*.unsafe": "#FF4D5E"
  }
}
